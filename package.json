{
  "name": "@adrian-zephyr/compulsive",
  "version": "0.1.1",
  "description": "A safe local Git repository organizer and CLI.",
  "keywords": [
    "cli",
    "developer-tools",
    "git",
    "repository-manager",
    "workspace"
  ],
  "homepage": "https://github.com/Adrian-Zephyr-Liao/compulsive#readme",
  "bugs": {
    "url": "https://github.com/Adrian-Zephyr-Liao/compulsive/issues"
  },
  "license": "MIT",
  "author": "Adrian Zephyr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adrian-Zephyr-Liao/compulsive.git"
  },
  "bin": {
    "cpl": "dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --run",
    "check": "vp check",
    "prepublishOnly": "vp check && vp test --run && vp pack --publint --attw"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^24.3.0",
    "publint": "0.3.24",
    "typescript": "^7.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.8",
    "vite-plus": "^0.2.8",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.24.0"
}
